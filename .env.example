# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./ielts_coach.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# OpenAI-compatible writing model. Leave the key blank to use the deterministic demo grader.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2500
MODEL_TIMEOUT_SECONDS=60
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_PATH=.cache/fastembed
HUGGINGFACE_CACHE_PATH=.cache/huggingface
LOCAL_EMBEDDING_STRICT=false

# Background jobs / uploads
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
